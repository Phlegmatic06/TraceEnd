{
  "name": "traceend",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Attack Surface Management & Digital Security Remediation Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "worker": "npx tsx src/lib/queue/worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
